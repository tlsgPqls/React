// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER // 사용자
  ADMIN //관리자
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String        @default("1234") // bcrypt 예정
  name         String
  comment      Comment[]
  profileImage ProfileImage?

  like      Like[]
  playlists Playlists[]
  role      Role        @default(USER)
}

model ProfileImage {
  id         Int    @id @default(autoincrement())
  url        String @default("http://localhost:3001/uploads/1.jpg")
  storedName String //저장파일이름
  userId     Int    @unique // 1:1 관계를 위해 @unique 필수
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Anime {
  id            Int             @id @default(autoincrement())
  title         String
  description   String
  posterImage String?
  episodes      Episode[]
  tags          AnimeTag[]
  playlistAnime PlaylistAnime[]
}

// 3. 에피소드 테이블 (화 수 분할)
model Episode {
  id            Int       @id @default(autoincrement())
  animeId       Int
  anime         Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episodeNumber Int // 제 1화, 제 2화 등
  videoUrl      String
  comments      Comment[] // 이 에피소드에 달린 타임라인 댓글들
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  timestamp Int // 💡 중요: 영상 시작 후 몇 초(second) 시점에 달린 댓글인지 저장 (예: 750초 = 12분 30초)
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  episodeId Int
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId, timestamp]) // 💡 성능 최적화: 특정 시간에 최적화된 인덱스 설정
}

// 5. 커스텀 플레이리스트 테이블
model Playlists {
  id     Int             @id @default(autoincrement())
  title  String // 예: "밥 먹을 때 보기 좋은 일상물"
  userId Int
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  PlaylistAnime[] // 플레이리스트에 담긴 애니메이션들 (다대다 교차테이블)
}

// 6. 플레이리스트와 애니메이션의 다대다(N:M) 관계를 푸는 매핑 테이블
model PlaylistAnime {
  playlistId Int
  playlists  Playlists @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  animeId    Int
  anime      Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@id([playlistId, animeId]) // 복합 기본키 설정
}

// 7. 태그 테이블 (일상, 판타지, 액션 등)
model Tag {
  id     Int        @id @default(autoincrement())
  name   String     @unique
  animes AnimeTag[]
}

model AnimeTag {
  animeId Int
  anime   Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  tagId   Int
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([animeId, tagId])
}

model Like {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])
}

model Worldcup {
  id       Int      @id @default(autoincrement())
  title    String //월드컵 제목
  desc     String?
  views    Int      @default(0) //조회수
  createdAt DateTime @default(now())

  items WorldcupItem[] //월드컵에 속한 후보들
  comments WorldcupComment[] // 
}

model WorldcupItem {
  id         Int    @id @default(autoincrement())
  name       String //후보 이름 (예: 고죠,게토)
  imageUrl   String //후보 이미지 경로
  winCount   Int    @default(0)
  matchCount Int    @default(0)

  worldcupId Int
  worldcup   Worldcup @relation(fields: [worldcupId], references: [id], onDelete: Cascade)
}
model WorldcupComment {
  id         Int      @id @default(autoincrement())
  nickname   String   // 작성자 닉네임
  content    String   // 댓글 내용
  createdAt  DateTime @default(now())

  worldcupId Int
  worldcup   Worldcup @relation(fields: [worldcupId], references: [id], onDelete: Cascade)
}